[Unit]
Description=UGREEN telemetry SMART and volume snapshot
ConditionPathExists=/root/ugreen-telemetry-mqtt/host.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /root/ugreen-telemetry-mqtt/host-smart-snapshot.py --config /root/ugreen-telemetry-mqtt/host.json --output /root/ugreen-telemetry-mqtt/snapshots/telemetry.json
TimeoutStartSec=180
Nice=10
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/ugreen-telemetry-mqtt/snapshots
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
